# Copy to .env.production only after choosing and owning the real domain.
APP_DOMAIN=app.example.invalid
API_DOMAIN=api.example.invalid
EXPO_PUBLIC_API_URL=https://api.example.invalid
BACKEND_CORS_ORIGINS=["https://app.example.invalid"]
APP_DEBUG=false

# Rede interna isolada do proxy para o FastAPI; altere se conflitar com a rede do host.
API_PROXY_SUBNET=172.28.240.0/24
API_PROXY_IP=172.28.240.2

# Per-IP limits; the production Compose runs one API instance.
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_CATALOG_PER_MINUTE=120

# Replace every sample value; production refuses weak/example JWT secrets.
POSTGRES_USER=preco_bao
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_URL_SAFE
POSTGRES_DB=preco_bao
DATABASE_URL=postgresql+psycopg2://preco_bao:REPLACE_WITH_A_RANDOM_PASSWORD_URL_SAFE@db:5432/preco_bao
JWT_SECRET=replace-with-a-unique-output-from-python-secrets-token-url-safe-48
