    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.22",
    "patch-package": "^8.0.1",
    "react-test-renderer": "^19.2.0",
    "typescript": "~5.9.2"
  }
