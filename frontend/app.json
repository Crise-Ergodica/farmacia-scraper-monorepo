{
  "expo": {
    "name": "Preço Bão",
    "slug": "farmacia-scraper-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "farmacia-scraper-frontend",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-screen.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F8FC",
          "dark": {
            "image": "./assets/splash-screen.png",
            "backgroundColor": "#101722"
          }
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash-screen.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F8FC"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.dragoniana.precobao",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#1688F6"
      },
      "permissions": []
    },
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f5472590-c34d-445d-adc1-b5bfbc2ba98e"
      }
    }
  }
}
