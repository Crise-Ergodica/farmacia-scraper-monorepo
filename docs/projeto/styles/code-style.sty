\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{code-style}[2025/12/22 Estilo de Codigo Personalizado]

% --- PACOTES NECESSÁRIOS ---
\RequirePackage{listings}
\RequirePackage{xcolor}
\RequirePackage{caption}
\RequirePackage{chngcntr}

% --- CORES ---
\definecolor{codegreen}{rgb}{0,0.6,0}
\definecolor{codegray}{rgb}{0.5,0.5,0.5}
\definecolor{codepurple}{rgb}{0.58,0,0.82}
\definecolor{backcolour}{rgb}{0.95,0.95,0.92}

% --- CONFIGURAÇÕES DE LEGENDA (ABNT) ---
% Remove numeração atrelada ao capítulo (Listagem 1.1 vira Listagem 1)
\AtBeginDocument{%
    \counterwithout{lstlisting}{chapter}
}

% Renomeia para adequação ao português
\renewcommand{\lstlistingname}{Listagem}
\renewcommand{\lstlistlistingname}{Lista de Listagens}

% Formato da legenda
\DeclareCaptionFormat{listing}{\footnotesize #1#2#3}
\captionsetup[lstlisting]{format=listing, labelsep=endash}

% A macro \fonte foi removida para preservar a integridade da classe abntex2.

% --- ESTILO VISUAL (LSTSET) ---
\lstset{
    language=Python,
    basicstyle=\ttfamily\footnotesize,
    breaklines=true,
    breakatwhitespace=true,
    captionpos=t,
    numbers=left,
    numbersep=5pt,
    numberstyle=\tiny\color{codegray},
    keywordstyle=\color{blue}\bfseries,
    commentstyle=\color{codegreen}\itshape,
    stringstyle=\color{codepurple},
    showstringspaces=false,
    frame=single, 
    rulecolor=\color{black},
    framerule=1.0pt,   
    tabsize=2,
    keepspaces=true,
    framesep=2pt,
    xleftmargin=25pt,
    framexleftmargin=20pt,
    xrightmargin=5pt,
    abovecaptionskip=10pt,
    belowcaptionskip=5pt,
    backgroundcolor=\color{backcolour},
    % MAPEAMENTO UTF-8 PARA EVITAR CRASH COM ACENTOS NO CÓDIGO
    literate={á}{{\'a}}1 {ã}{{\~a}}1 {é}{{\'e}}1 {ê}{{\^e}}1 {í}{{\'i}}1 
             {ó}{{\'o}}1 {õ}{{\~o}}1 {ú}{{\'u}}1 {ç}{{\c{c}}}1 {Á}{{\'A}}1 
             {Ã}{{\~A}}1 {É}{{\'E}}1 {Ê}{{\^E}}1 {Í}{{\'I}}1 {Ó}{{\'O}}1 
             {Õ}{{\~O}}1 {Ú}{{\'U}}1 {Ç}{{\c{C}}}1
}