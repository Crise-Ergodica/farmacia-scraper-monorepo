# backend/.env
PROJECT_NAME="Farmácia Scraper API"
API_V1_STR="/api/v1"
DEBUG=True

# Gere valores próprios para o ambiente. Mantenha os dois URLs com o mesmo usuário,
# senha e banco; codifique caracteres especiais da senha como percent-encoding nos URLs.
POSTGRES_USER="preco_bao"
POSTGRES_PASSWORD="replace-with-a-long-random-password"
POSTGRES_DB="farmacia_db"
DATABASE_URL="postgresql+psycopg2://preco_bao:replace-with-a-long-random-password@127.0.0.1:4242/farmacia_db"
DATABASE_URL_DOCKER="postgresql+psycopg2://preco_bao:replace-with-a-long-random-password@db:5432/farmacia_db"

# Rotinas de manutenção não são iniciadas no perfil comum do Compose.
IMAGE_MONITOR_ENABLED=true
IMAGE_RECOVERY_ENABLED=true
IMAGE_MONITOR_BATCH_SIZE=100
IMAGE_RECOVERY_BATCH_SIZE=100
IMAGE_MONITOR_RECHECK_HOURS=24
IMAGE_MONITOR_CONCURRENCY=4
IMAGE_MONITOR_HOST_INTERVAL=0.5
IMAGE_MAINTENANCE_INTERVAL_SECONDS=86400

# Segurança e CORS (Exemplo: permitir localhost do Expo)
BACKEND_CORS_ORIGINS=["http://localhost:8081"]
JWT_SECRET="substitua-por-um-segredo-aleatorio-longo-e-mantenha-o-mesmo-valor-no-deploy"
